      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="application/geo+json" />
        <data android:mimeType="application/vnd.garmin.tcx+xml" />
        <data android:mimeType="application/vnd.ant.fit" />
        <data android:mimeType="application/x-ovmap" />
        <data android:mimeType="application/vnd.ovmap" />
        <data android:mimeType="text/csv" />
        <data android:mimeType="text/tab-separated-values" />
        <data android:mimeType="application/gpx+xml" />
        <data android:mimeType="application/vnd.google-earth.kml+xml" />
        <data android:mimeType="application/vnd.google-earth.kmz" />
        <data android:mimeType="application/json" />
        <data android:mimeType="application/xml" />
        <data android:mimeType="text/xml" />
        <data android:mimeType="text/plain" />
        <data android:mimeType="application/octet-stream" />
      </intent-filter>
    </activity>
  <activity-alias android:name="com.guanyun.weather.MainActivity" android:targetActivity="com.guanyun.weather.NativeReactActivity" android:exported="true">
    <intent-filter>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent-filter>
  </activity-alias>
  <activity android:name="com.shantu.nativeapp.ui.NativeQrActivity" android:exported="false" android:screenOrientation="portrait" />
</application>
